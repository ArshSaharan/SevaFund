# ==============================================================================
# SevaFund India - Environment Configuration Template
# ==============================================================================

DATABASE_URL=sqlite:///./crowdfund.db
SECRET_KEY=sevafund-production-jwt-secret-key-india-2026
DEBUG=True

# Real SMS Delivery (Fast2SMS for Indian Mobile Numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# (Alternative) Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1XXXXXXXXXX

# Google OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Test or Live)
# Leave blank to use built-in simulation mode
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Gemini AI (for Campaign Verification & Assistant)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# AI Thresholds
AI_AUTO_APPROVE_SCORE_THRESHOLD=80.0
AI_REVIEW_SCORE_THRESHOLD=50.0

# Indian Financials
PLATFORM_FEE_PERCENTAGE=0.00
GATEWAY_FEE_PERCENTAGE=0.02
GATEWAY_GST_PERCENTAGE=0.18
UPI_FIXED_FEE_INR=0.00

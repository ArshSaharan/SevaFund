# ==============================================================================
# SevaFund India - Environment Configuration Template
# ==============================================================================

DATABASE_URL=sqlite:///./crowdfund.db
# Generate your own and put it in .env (never commit it): python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_with_a_random_secret_DO_NOT_USE_THIS_PLACEHOLDER
DEBUG=True

# Demo accounts created by seed_data.py (priya.sharma@example.com, rahul.verma@example.com, admin@crowdfund-trust.in).
# Required by seed_data.py: private passwords of at least 12 characters. They are never printed.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# Optional: SMS delivery for phone (OTP) sign-in. Leave empty to run without SMS credits; email and password
# sign-in is the primary method, and phone sign-in is then shown as temporarily unavailable.
FAST2SMS_API_KEY=

# (Alternative) Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1XXXXXXXXXX

# Google OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Test or Live)
# Leave blank to use built-in simulation mode
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Gemini AI (for Campaign Verification & Assistant)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# AI Thresholds
AI_AUTO_APPROVE_SCORE_THRESHOLD=80.0
AI_REVIEW_SCORE_THRESHOLD=50.0

# Indian Financials
PLATFORM_FEE_PERCENTAGE=0.00
GATEWAY_FEE_PERCENTAGE=0.02
GATEWAY_GST_PERCENTAGE=0.18
UPI_FIXED_FEE_INR=0.00
